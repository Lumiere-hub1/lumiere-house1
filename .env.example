# Lumière House — environment variables
#
# Copy this file to `.env` in the project root and fill in the values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file (.env.example)
# holds NAMES ONLY, never values, and is the one env file that is committed.
#
# How it is loaded:
#   - server/app.ts imports "dotenv/config"        → the Express server
#   - app.config.ts imports scripts/load-env.js    → Expo, plus EXPO_PUBLIC_ mapping
#   - scripts/migrate.mjs imports "dotenv/config"  → pnpm db:migrate
#
# In all three, a variable already set in the real environment WINS over the
# value here. That is deliberate: on Vercel the platform's own variables must
# not be shadowed by a local placeholder.
#
# Sections marked NOT YET USED are listed so there is one place to put keys as
# features land. Nothing reads them today — setting them changes no behaviour.


# ---------------------------------------------------------------------------
# REQUIRED — the server cannot serve authenticated traffic without these
# ---------------------------------------------------------------------------

# Aiven MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Read by server/db.ts, scripts/migrate.mjs and drizzle.config.ts.
DATABASE_URL=

# Secret used to sign session cookies. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=


# ---------------------------------------------------------------------------
# AI / content generation
# ---------------------------------------------------------------------------

# Reaching Claude for the Content Studio /SCRIPT command and the Telegram
# support bot. Read by server/_core/anthropic.ts.
#
# There are TWO ways to do this and they are not interchangeable. Set ONE.
#
#   Option A — Amazon Bedrock (billed to an AWS account, e.g. AWS credits).
#   The key is the long "ABSK…" string from the Bedrock console. It is NOT an
#   Anthropic key and putting it in ANTHROPIC_API_KEY fails with a bare 401.
#   Region is required: Bedrock is regional and the SDK has no default.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_AWS_REGION=us-east-1

#   Option B — Anthropic's own API (billed to an Anthropic account).
#   The key starts with "sk-ant-". Ignored when Option A is set.
ANTHROPIC_API_KEY=

# Selects which provider drives content.generate. Read by server/_core/env.ts.
LLM_PROVIDER=

# YouTube Data API v3 key for the /TRENDS command. Read by server/_core/youtube.ts.
#
# This must be an API KEY — a Google Cloud key that starts with "AIza", created
# under APIs & Services > Credentials with "YouTube Data API v3" enabled on the
# same project. Three things that are NOT this and will not work:
#   - an OAuth client ID (ends "…apps.googleusercontent.com")
#   - an OAuth client secret (starts "GOCSPX-")
#   - a Google AI Studio / Gemini key (starts "AQ."), which is scoped to
#     generativelanguage.googleapis.com and is refused by the YouTube API
# Quota note: search.list costs 100 of the project's 10,000 units per day, so
# the whole product gets roughly 100 /TRENDS calls a day. Hence the rate limit.
YOUTUBE_API_KEY=

# NVIDIA NIM credentials for the existing content.generate flow.
NVIDIA_API_KEY=
# Optional. Defaults to nvidia/nemotron-3.5-lightning-30b-a3b when unset.
NVIDIA_MODEL=

# Forge (OpenAI-shaped) endpoint used by server/_core/llm.ts.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=


# ---------------------------------------------------------------------------
# OAuth and identity
# ---------------------------------------------------------------------------

OAUTH_SERVER_URL=
OAUTH_PORTAL_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# Mapped to EXPO_PUBLIC_* by scripts/load-env.js for the client bundle.
# Anything EXPO_PUBLIC_ is compiled INTO the web bundle and is publicly
# readable — never put a secret in one.
OWNER_NAME=
VITE_OAUTH_PORTAL_URL=


# ---------------------------------------------------------------------------
# CORS and web origins
# ---------------------------------------------------------------------------

# Comma-separated list of allowed origins. Read by server/_core/env.ts.
ALLOWED_ORIGINS=
EXPO_WEB_PREVIEW_URL=


# ---------------------------------------------------------------------------
# TikTok Login Kit — the only social platform wired up today
# ---------------------------------------------------------------------------

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must be an https:// URL, or the server reports the config invalid.
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=


# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------

# Base URL the end-to-end scripts in scripts/ hit.
# Defaults to http://127.0.0.1:3000 when unset.
LUMIERE_API_BASE=


# ---------------------------------------------------------------------------
# NOT YET USED — no code reads these. Placeholders for planned work.
# ---------------------------------------------------------------------------

# Discussed as an LLM fallback. No integration exists yet.
OPENROUTER_API_KEY=

# Meta (Facebook + Instagram Graph API). No integration exists yet.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Pinterest API. No integration exists yet.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
